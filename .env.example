# ClearQuote Environment Configuration Example
# Optional manual run: copy to .env, then node --env-file=.env server.mjs
# The prepared launcher instead prompts privately and keeps credentials in memory.
 
# PayPal Sandbox API credentials (Orders v2)
# Use ONLY https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
 
# OpenAI-compatible AI Provider configuration (for natural language quote extraction)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
 
# The launcher supplies these private-demo values automatically.
# PUBLIC_ORIGIN=exact HTTPS tunnel origin
# DEMO_APP_ORIGIN=exact approved frontend origin
# DEMO_ACCESS_TOKEN=random run-scoped value, at least 40 URL-safe characters
